#!/usr/bin/env python3
"""Run every blocking check this repository has, and write a report an agent can fix from.

    python scripts/test-agent            # everything; exit 0 only if all passed
    python scripts/test-agent --list     # the check names
    python scripts/test-agent -k wiring  # only checks whose name contains "wiring"

This is the single list of what CI's `validate` job runs (`.github/workflows/
ci.yml` calls it and nothing else), so a suite is wired in one place, here, not
twice. It also closes the gap that list had: a new test file was run by nothing
until someone remembered to add it to ci.yml. The `every-test-file-is-run`
check below now fails naming any test file that no check runs.

Output, in `.test-report/` (gitignored, uploaded by CI as an artifact):
  summary.md    per failure: check name, file:line, the failing lines from its
                output, the exact command to rerun only that check, its log
  results.json  the same, machine-readable
  junit.xml     one testcase per check
  logs/<name>.log  full stdout+stderr of every check

Stdlib only, like everything else here: this repository has no package.json
and no requirements file, and a test runner must not become a dependency for
every adopter.

Every check runs from the repository root with a fresh, empty HOME (nothing can
read or write a real `~/.hermes`, `~/.claude` or `~/.config`), TZ=UTC and a
fixed locale, and is killed after a timeout instead of hanging the run. Python
checks run under the interpreter running this script and Node checks under the
`node` on PATH, so no `python` alias is needed.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET
from dataclasses import dataclass, field
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PY = "{python}"
NODE = "{node}"
DEFAULT_TIMEOUT = 300

# Test files by name. Anything matching that no check below runs is an error.
TEST_FILE = re.compile(r"(^|/)(test_[^/]*\.py|[^/]*\.test\.m?js)$")
# Generated copies of sdlc-suite/skills/: the hand-edited source is what runs
# (generate_trees.py --check proves the copies are identical to it).
GENERATED_COPY = re.compile(
    r"^(\.agents|\.claude|\.codex|\.copilot|\.kimi-code|commandcode-suite)/skills/"
)


@dataclass
class Check:
    name: str
    argv: list[str]
    why: str
    # Test files this check runs, for the every-test-file-is-run check. Defaults
    # to the arguments that look like test files.
    covers: list[str] = field(default_factory=list)
    timeout: int = DEFAULT_TIMEOUT

    def covered(self) -> list[str]:
        return self.covers or [a for a in self.argv if TEST_FILE.search(a)]


def _suite(path: str, why: str) -> Check:
    runner = NODE if path.endswith((".js", ".mjs")) else PY
    return Check(Path(path).name, [runner, path], why)


# The order is CI's old step order. The "why" of each check is printed with its
# failure: it is the history that explains what the gate protects, moved here
# from ci.yml's step comments so it is not lost.
