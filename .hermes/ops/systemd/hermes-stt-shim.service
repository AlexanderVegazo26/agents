[Unit]
Description=Fixed-port front for the LlamaStash whisper launch (Hermes voice notes)
After=llamastash.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.hermes/scripts/stt_shim.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target
